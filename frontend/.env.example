# Desarrollo local: conserva la simulación y no requiere Supabase.
SISTEMA_R_DATA_SOURCE=demo

# Vercel Preview → Supabase staging. Todas son obligatorias en ese ambiente.
# SISTEMA_R_DATA_SOURCE=supabase
# SISTEMA_R_DEPLOYMENT_TARGET=staging
# SISTEMA_R_EXPECTED_SUPABASE_PROJECT_REF=REF_STAGING
# Debe coincidir con https://VERCEL_BRANCH_URL (o VERCEL_URL si no hay rama).
# SISTEMA_R_SITE_URL=https://TU-PREVIEW.vercel.app
# SUPABASE_URL=https://REF_STAGING.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR
# SISTEMA_R_USERNAME_DOMAIN=auth.sistema-r.invalid

# Vercel Production → otro proyecto Supabase y, antes del Go, dominio propio.
# SISTEMA_R_DATA_SOURCE=supabase
# SISTEMA_R_DEPLOYMENT_TARGET=production
# SISTEMA_R_EXPECTED_SUPABASE_PROJECT_REF=REF_PRODUCCION_DISTINTO
# Debe coincidir con https://VERCEL_PROJECT_PRODUCTION_URL.
# SISTEMA_R_SITE_URL=https://sistema-r.TU-DOMINIO.example
# SUPABASE_URL=https://REF_PRODUCCION_DISTINTO.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR
# SISTEMA_R_USERNAME_DOMAIN=auth.sistema-r.invalid

# Nunca añadas SUPABASE_SECRET_KEY, SUPABASE_SERVICE_ROLE_KEY, sb_secret_ ni
# una clave privilegiada dentro de variables NEXT_PUBLIC o del repositorio.
