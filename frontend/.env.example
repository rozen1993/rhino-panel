# Modo local aprobado: conserva la simulación y no requiere Supabase.
SISTEMA_R_DATA_SOURCE=demo

# Vercel exige declarar el modo; staging/producción usan `supabase`.
# SISTEMA_R_DATA_SOURCE=supabase
# SUPABASE_URL=https://TU-PROYECTO.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR
# SISTEMA_R_USERNAME_DOMAIN=auth.sistema-r.invalid

# Nunca añadas aquí ni en variables NEXT_PUBLIC una secret/service_role key.
